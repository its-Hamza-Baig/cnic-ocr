APP_NAME="CNIC Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=cnic_ocr
DB_USERNAME=cnic
DB_PASSWORD=cnic

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

OCR_PROVIDER=paddleocr
OCR_TIMEOUT_SECONDS=180
OCR_RATE_LIMIT_PER_MINUTE=10
OCR_MAX_UPLOAD_KB=5120
OCR_STORE_RAW_TEXT=false
OCR_RAW_TEXT_RETENTION_HOURS=24
PADDLEOCR_URL=http://127.0.0.1:8868
PADDLEOCR_LANGS=en,ar
TESSERACT_BINARY=tesseract
TESSERACT_LANG=eng
TESSERACT_BACK_LANG=urd
TESSERACT_SCRIPTS=eng,urd
TESSERACT_PSM=6
TESSERACT_DOCKER_IMAGE=cnic-ocr-tesseract
GOOGLE_VISION_API_KEY=
GOOGLE_VISION_ENDPOINT=https://vision.googleapis.com/v1/images:annotate

CNIC_DISK=cnic
CNIC_TEMP_IMAGE_RETENTION_HOURS=24
CNIC_PERSON_IMAGE_RETENTION_DAYS=
CNIC_SENSITIVE_RATE_LIMIT_PER_MINUTE=30

VITE_APP_NAME="${APP_NAME}"
